---
import { getCollection } from "astro:content";
import MenuLink from "./MenuLink.astro";

const { headline } = Astro.props;

const category = Astro.props.category || Astro.params.category;

const base = import.meta.env.BASE_URL;

const allDocs = await getCollection("docs");
---

<div class="px-3 pb-3 typo-info text-gray-500">
  <span>{headline || category}</span>
</div>

<nav>
  <ul class="flex flex-col gap-1">
    {
      allDocs
        .filter(doc => {
          const parts = doc.id.split("/");
          if (parts.length === 2 && parts[0] === category) return true;
          if (parts.length === 3 && parts[0] === category && parts[2] === "index")
            return true;
          return false;
        })
        .sort((a, b) => {
          const orderA = a.data.order ?? 1;
          const orderB = b.data.order ?? 1;
          if (orderA !== orderB) return orderA - orderB;
          // same order, sort alphabetically
          return a.data.title?.localeCompare(b.data.title || "") || 0;
        })
        .map(doc => {
          return (
            <li>
              <MenuLink
                href={`/${[...base.split("/"), ...doc.id.split("/")].filter(Boolean).join("/")}`}
              >
                {doc.data.title}
              </MenuLink>
            </li>
          );
        })
    }
  </ul>
</nav>
