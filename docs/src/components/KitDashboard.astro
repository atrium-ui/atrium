---
/**
 * Renders the kit dashboard (index.html body) inside a fixed-height isolated
 * iframe, plus the full source below. The dashboard composes all kit components
 * into a generic admin UI.
 */
import basicsDashboardHtml from "../../../packages/kits/src/basics/index.html?raw";
import { kitPreviewDocument } from "./kit-preview-doc";

export interface Props {
  kit?: string;
}

const { kit = "basics" } = Astro.props;

const dashboardFiles = import.meta.glob("../../../packages/kits/src/*/index.html", {
  as: "raw",
  eager: true,
}) as Record<string, string>;

const dashboardHtml =
  Object.entries(dashboardFiles).find(([path]) => path.includes(`/kits/src/${kit}/`))?.[1] ??
  basicsDashboardHtml;

const base = import.meta.env.BASE_URL;
const body = dashboardHtml.match(/<body[^>]*>([\s\S]*)<\/body>/i)?.[1] ?? dashboardHtml;
const srcdoc = kitPreviewDocument(body, `${base}kit-preview/elements.js`, kit);
---

<!-- NOTE: plain <div> wrapper, not <section> — docs layout.css styles all
  `section` elements globally (padding-inline + overflow), which would
  indent and clip the preview. -->
<div class="not-content mb-10">
  <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-white">
    <iframe
      title="Dashboard preview"
      srcdoc={srcdoc}
      loading="lazy"
      sandbox="allow-scripts allow-forms"
      scrolling="no"
      class="block h-[1100px] w-full overflow-hidden border-0"
    />
  </div>
  <details class="mt-2 rounded-xl border border-zinc-200 bg-zinc-50">
    <summary class="cursor-pointer px-4 py-2 text-sm font-medium text-zinc-700">Show HTML</summary>
    <pre class="overflow-x-auto border-t border-zinc-200 p-4 text-xs leading-5"><code>{dashboardHtml}</code></pre>
  </details>
</div>
