---
interface Props {
  href: string;
}

const { href } = Astro.props;
const normalize = (path: string) => path.replace(/\/(?:index)?\/?$/, "");
const current = normalize(Astro.url.pathname) === normalize(href);
---

<a
  href={href}
  aria-current={current ? "page" : undefined}
  class="flex min-h-9 w-full items-center rounded-md px-3 py-2 text-sm font-medium leading-5 text-(--style-typography-body) no-underline hover:bg-(--style-fill-gray-active) active:bg-gray-100 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-gray-400 aria-[current=page]:bg-(--style-fill-gray-active) aria-[current=page]:font-semibold"
>
  <span><slot /></span>
</a>
