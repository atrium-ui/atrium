{
  "name": "@atrium-ui/calendar",
  "version": "0.1.0",
  "description": "Endless, zoomable week-row calendar as a dependency-free custom element",
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "dev": "bun demo/index.html",
    "build": "bun build src/index.ts --outdir dist --target browser --minify --sourcemap=linked"
  },
  "license": "MIT"
}
